# Fill this in, save as .env.golive (gitignored), then run ./scripts/go-live.sh
# Every value below comes from a page you have to be logged in to. That is the
# only part of go-live that cannot be automated.

# ── Supabase ────────────────────────────────────────────────────────────────
# Personal access token: supabase.com/dashboard/account/tokens  (no browser
# login needed afterwards — the CLI reads this from the environment)
SUPABASE_ACCESS_TOKEN=
# Project ref: the id in your project URL, e.g. abcdefghijklmnop
SUPABASE_PROJECT_REF=
# The database password you set when creating the project
SUPABASE_DB_PASSWORD=
# Project Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider ─────────────────────────────────────────────────────────────
# openrouter.ai → Keys → Create Key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Pick a slug from openrouter.ai/models that supports structured outputs
AI_MODEL=

# ── Approver identity ───────────────────────────────────────────────────────
# Who is allowed to approve publishing. Both are required: a publishing
# decision must name a real person, never "whoever sorts first".
# Sign in to the app once, then read your uuid from Supabase → Authentication.
SUPABASE_APPROVER_USER_ID=
# Your numeric Telegram user id (the script prints it after you message the bot).
TELEGRAM_APPROVER_USER_ID=

# ── Telegram ────────────────────────────────────────────────────────────────
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Any long random string you invent — it authenticates Telegram back to us
TELEGRAM_WEBHOOK_SECRET=

# ── This app ────────────────────────────────────────────────────────────────
# Invent a long random string. Used by n8n to call the automation API.
AUTOMATION_SECRET=
CREATIVE_WORKER_SECRET=
# Your deployed URL. Leave blank on the first run to do everything except the
# steps that need a public URL.
APP_URL=
