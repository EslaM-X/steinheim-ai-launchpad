# Copy to .env next to docker-compose.yml. Never commit the filled file.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=n8n

# Generate once and keep it safe — losing it invalidates every saved credential:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Local development (Windows/Docker Desktop):
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# On a VPS behind a domain, switch to:
# N8N_HOST=automation.steinheim-eg.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://automation.steinheim-eg.com/

# --- secrets the workflows will call the Launchpad app with (Phase E) ---
# AUTOMATION_SECRET=
# APP_BASE_URL=https://<your-launchpad-deployment>
