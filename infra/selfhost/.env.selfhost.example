# Copy to infra/selfhost/.env . Same values as the Vercel dashboard, plus two
# for n8n's own database. Never commit the filled file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# The pipeline asks for JSON matching a schema. Several free models advertise
# structured outputs and then ignore response_format, answering with prose —
# nvidia/nemotron-3-super-120b-a12b:free does exactly that, and every generation
# fails with "No object generated". Verified to honour the schema on the free
# tier: google/gemma-4-26b-a4b-it:free and openai/gpt-oss-20b:free.
AI_MODEL=google/gemma-4-26b-a4b-it:free

AUTOMATION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CREATIVE_MODE=mock
CREATIVE_WORKER_SECRET=

N8N_DB_PASSWORD=
# openssl rand -hex 32 — losing this makes every stored n8n credential unreadable
N8N_ENCRYPTION_KEY=
