# Copy to infra/selfhost/.env . Same values as the Vercel dashboard, plus two
# for n8n's own database. Never commit the filled file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

AUTOMATION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CREATIVE_MODE=mock
CREATIVE_WORKER_SECRET=

N8N_DB_PASSWORD=
# openssl rand -hex 32 — losing this makes every stored n8n credential unreadable
N8N_ENCRYPTION_KEY=
