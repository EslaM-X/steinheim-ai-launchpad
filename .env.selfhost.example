# Copy to .env at the repo root. Same values as the Vercel dashboard, plus two
# for n8n's own database. Never commit the filled file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# The pipeline asks for JSON matching a schema. Several free models advertise
# structured outputs and then ignore response_format, answering with prose —
# nvidia/nemotron-3-super-120b-a12b:free does exactly that, and every generation
# fails with "No object generated". Verified to honour the schema on the free
# tier: google/gemma-4-26b-a4b-it:free and openai/gpt-oss-20b:free.
AI_MODEL=google/gemma-4-26b-a4b-it:free

AUTOMATION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CREATIVE_MODE=mock
CREATIVE_WORKER_SECRET=

N8N_DB_USER=n8n
N8N_DB_NAME=n8n
N8N_DB_PASSWORD=

# ── n8n workflow deploy (START.bat uses these when importing workflows) ──────
# The private ops chat id from @userinfobot, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# The public content channel. Leave empty to default to the ops chat, so a
# misconfigured run posts somewhere private rather than to an audience.
TELEGRAM_CHANNEL_ID=
# openssl rand -hex 32 — losing this makes every stored n8n credential unreadable
N8N_ENCRYPTION_KEY=

# n8n owner account — START.bat creates it on first boot and logs in with it
# to deploy workflows and credentials automatically. No manual n8n setup.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

# ── Where the front end lives ────────────────────────────────────────────────
# Leave both at the defaults when the whole stack is on this box.
#
# When the UI is hosted on a platform with a request ceiling (Netlify cuts a
# synchronous function at 60 seconds), set APP_URL to the public site and
# WORKER_URL to this box. The UI then triggers work here and polls the jobs
# table for progress; nothing long ever runs inside the hosted function.
APP_URL=http://localhost:3000
WORKER_URL=http://localhost:3000

# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
# A named-tunnel token from the Cloudflare Zero Trust dashboard. With it set,
#   docker compose --profile tunnel up -d
# publishes the app on a fixed hostname without opening an inbound port.
# Point it at a hostname that is NOT steinheim-eg.com.
TUNNEL_TOKEN=

# The same hostname the tunnel serves, e.g. https://ai.your-domain.com.
# START.bat registers the Telegram webhook here on every boot, so approvals
# work from anywhere. Leave empty to keep the bot local-only.
PUBLIC_URL=

# Models to try when the primary fails, comma separated and in order. A free
# provider answering "temporarily overloaded", or a model that quietly stops
# honouring JSON schemas, then costs a retry rather than the day content.
# Credit and key errors do not walk the chain: those are properties of the
# account, and every model on it would fail the same way.
AI_MODEL_FALLBACKS=

# ── Photographic backgrounds (optional) ──────────────────────────────────────
# Real interiors to place products into. Both are free and both licence their
# images for commercial use in writing, which Pinterest does not: its images
# belong to the photographers who made them, and putting one behind a product
# in a paid campaign is infringement.
#
#   Unsplash : https://unsplash.com/developers  (Create an app, copy Access Key)
#   Pexels   : https://www.pexels.com/api/      (Get Started, copy API Key)
#
# Either alone is enough. With neither set, renders fall back to the built-in
# studio backdrop — plainer, never wrong.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
